library(dplyr)
gii |>
filter(indexCode == "GII") |>
distinct(indicatorCode, indicator) |>
print(n = Inf)
library(dplyr)
library(tidyr)
gii_change <- gii |>
filter(
indicatorCode == "gii",
year %in% c(2010, 2019)
) |>
select(
iso3 = countryIsoCode,
country,
year,
value
) |>
pivot_wider(
names_from = year,
values_from = value,
names_prefix = "GII_"
) |>
mutate(
gii_diff = GII_2019 - GII_2010
)
head(gii_change)
world_gii <- world |>
mutate(
iso3 = countrycode(ISO, "iso2c", "iso3c")
) |>
left_join(gii_change, by = "iso3")
# 查看结果
head(st_drop_geometry(world_gii))
# 成功匹配的空间要素数量
sum(!is.na(world_gii$gii_diff))
# 没有完整 GII 差值的空间要素数量
sum(is.na(world_gii$gii_diff))
# 查看结果
head(st_drop_geometry(world_gii))
