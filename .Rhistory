sum(is.na(world_gii$gii_diff))
world_gii |>
filter(is.na(gii_diff)) |>
st_drop_geometry() |>
select(COUNTRY, ISO, iso3)
library(ggplot2)
ggplot(world_gii) +
geom_sf(
aes(fill = gii_diff),
colour = NA
) +
scale_fill_gradient2(
low = "blue",
mid = "white",
high = "red",
midpoint = 0,
na.value = "grey85"
) +
labs(
title = "Global Change in Gender Inequality",
subtitle = "2010–2019",
fill = "Δ GII",
caption = "Source: UNDP Human Development Reports"
) +
theme_minimal()
world_gii_equalearth <- st_transform(world_gii, 8857)
list.files("data/week4")
gii_map <- ggplot(world_gii_equalearth) +
geom_sf(aes(fill = gii_diff), colour = NA) +
scale_fill_gradient2(
low = "blue",
mid = "white",
high = "red",
midpoint = 0,
na.value = "grey85"
) +
labs(
title = "Global Change in Gender Inequality",
subtitle = "2010–2019",
fill = "Δ GII",
caption = "Source: UNDP Human Development Reports"
) +
theme_minimal()
gii_map
dir.create("figures", showWarnings = FALSE)
